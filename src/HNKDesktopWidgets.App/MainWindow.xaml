<?xml version="1.0" encoding="utf-8"?>
<Window
	x:Class="HNKDesktopWidgets.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Padding="24" RowSpacing="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<TextBlock Text="HNK Desktop Widgets" Style="{StaticResource TitleTextBlockStyle}" />
		<TextBlock Grid.Row="1" TextWrapping="Wrap"
				   Text="This window is the management shell. The clock and weather widgets are separate borderless Win32 windows rendered with Direct2D and DirectWrite." />
		<TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" />
		<StackPanel Grid.Row="3" Spacing="8">
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button x:Name="ToggleButton" Content="Hide clock" Click="OnToggleClock" />
				<Button x:Name="WeatherButton" Content="Hide weather" Click="OnToggleWeather" />
				<Button x:Name="AcrylicButton" Content="Use solid background" Click="OnToggleAcrylic" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button x:Name="ClockClickThroughButton" Content="Enable clock click-through" Click="OnToggleClockClickThrough" />
				<Button x:Name="WeatherClickThroughButton" Content="Enable weather click-through" Click="OnToggleWeatherClickThrough" />
				<Button Content="Settings" Click="OnOpenSettings" />
				<Button Content="Widget editor" Click="OnOpenEditor" />
			</StackPanel>
		</StackPanel>
		<Frame x:Name="ContentFrame" Grid.Row="4" />
	</Grid>
</Window>
